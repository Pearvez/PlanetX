from pathlib import Path
from functools import lru_cache
from io import BytesIO
import json
import os

import numpy as np
import requests

from flask import Flask, jsonify, request, send_from_directory
from flask_cors import CORS # type: ignore
from PIL import Image

from astropy_healpix import HEALPix
from astropy.coordinates import SkyCoord
import astropy.units as u




BASE_DIR = Path(__file__).resolve().parent

HIPS_BASE_URL = (
    "https://irsa.ipac.caltech.edu/data/hips/SPHEREx/"
    "spherex_allsky_cube"
)

HEALPIX_ORDER = 5
TOTAL_TILES = 12_288
TOTAL_CHANNELS = 102

CACHE_SIZE = 128
REQUEST_TIMEOUT = 30

CANDIDATES_FILE = Path(
    os.environ.get(
        "PLANETX_CANDIDATES_FILE",
        "/tmp/planetx_candidates.json"
    )
)

app = Flask(__name__)
CORS(app)

session = requests.Session()

healpix = HEALPix(
    nside=2 ** HEALPIX_ORDER,
    order="nested",
    frame=None
)



def validate_coordinates(ra, dec):
    if not 0 <= ra < 360:
        raise ValueError("RA must be between 0 and 360.")

    if not -90 <= dec <= 90:
        raise ValueError("Dec must be between -90 and 90.")


def validate_channel(channel):
    if not 1 <= channel <= TOTAL_CHANNELS:
        raise ValueError(
            f"Channel must be between 1 and {TOTAL_CHANNELS}."
        )


def get_tile_index(ra, dec):
    validate_coordinates(ra, dec)

    coordinate = SkyCoord(
        ra=ra * u.deg,
        dec=dec * u.deg,
        frame="icrs"
    )

    return int(
        healpix.skycoord_to_healpix(coordinate) # type: ignore
    )


def get_tile_center(tile_index):
    if not 0 <= tile_index < TOTAL_TILES:
        raise ValueError("Invalid HEALPix tile index.")

    coordinate = healpix.healpix_to_skycoord(
        tile_index
    )

    assert coordinate.dec is not None
    assert coordinate.ra is not None
    return (
        float(coordinate.ra.deg), # type: ignore
        float(coordinate.dec.deg) # type: ignore
    )


def get_tile_directory(tile_index):
    return (tile_index // 10_000) * 10_000


def get_png_url(tile_index, channel):
    directory = get_tile_directory(tile_index)

    return (
        f"{HIPS_BASE_URL}/"
        f"Norder{HEALPIX_ORDER}/"
        f"Dir{directory}/"
        f"Npix{tile_index}_{channel}.png"
    )


@lru_cache(maxsize=CACHE_SIZE)
def download_hips_tile(tile_index, channel):
    url = get_png_url(tile_index, channel)

    response = session.get(
        url,
        timeout=REQUEST_TIMEOUT
    )

    if response.status_code == 404:
        return None

    response.raise_for_status()

    image_bytes = response.content

    image = Image.open(BytesIO(image_bytes))
    image.verify()

    return image_bytes


def load_candidates():
    try:
        if CANDIDATES_FILE.exists():
            with open(CANDIDATES_FILE, "r") as file:
                data = json.load(file)

            return data if isinstance(data, list) else []

    except (OSError, json.JSONDecodeError):
        pass

    return []


def save_candidates(candidates):
    CANDIDATES_FILE.parent.mkdir(
        parents=True,
        exist_ok=True
    )

    temporary_file = CANDIDATES_FILE.with_suffix(".tmp")

    with open(temporary_file, "w") as file:
        json.dump(candidates, file, indent=2)

    temporary_file.replace(CANDIDATES_FILE)



@app.route("/api/health")
def health():
    return jsonify({
        "status": "ok",
        "service": "PlanetX SPHEREx Sky Explorer",
        "archive": "IRSA",
        "cube_release": "DR1",
        "cube_base_url": HIPS_BASE_URL,
        "all_sky_cube": True,
        "healpix_order": HEALPIX_ORDER,
        "healpix_ordering": "NESTED",
        "total_sky_tiles": TOTAL_TILES,
        "spectral_channels": TOTAL_CHANNELS
    })



@app.route("/api/sky/info")
def sky_info():
    return jsonify({
        "status": "ok",
        "release": "DR1",
        "total_tiles": TOTAL_TILES,
        "healpix_order": HEALPIX_ORDER,
        "ordering": "NESTED",
        "spectral_channels": TOTAL_CHANNELS,
        "data_source": HIPS_BASE_URL
    })


@app.route("/api/sky/tiles")
def sky_tiles():
    try:
        offset = int(request.args.get("offset", 0))
        limit = int(request.args.get("limit", 1000))

        if offset < 0:
            raise ValueError("Offset cannot be negative.")

        limit = min(max(limit, 1), 2000)

        end = min(offset + limit, TOTAL_TILES)

        tiles = []

        for tile_index in range(offset, end):
            ra, dec = get_tile_center(tile_index)

            tiles.append({
                "id": tile_index,
                "ra": ra,
                "dec": dec,
                "status": "available_for_lookup"
            })

        return jsonify({
            "status": "ok",
            "offset": offset,
            "limit": limit,
            "total": TOTAL_TILES,
            "tiles": tiles
        })

    except ValueError as error:
        return jsonify({
            "status": "error",
            "message": str(error)
        }), 400

@app.route("/api/sky/tile")
def sky_tile():
    try:
        ra = float(request.args["ra"])
        dec = float(request.args["dec"])

        channel = int(
            request.args.get("channel", 1)
        )

        validate_coordinates(ra, dec)
        validate_channel(channel)

        tile_index = get_tile_index(ra, dec)

        tile_ra, tile_dec = get_tile_center(
            tile_index
        )

        image_bytes = download_hips_tile(
            tile_index,
            channel
        )

        if image_bytes is None:
            return jsonify({
                "status": "unavailable",
                "message": "No PNG tile was found for this coordinate and channel.",
                "tile_id": tile_index,
                "channel": channel
            }), 404

        import base64

        encoded_image = base64.b64encode(
            image_bytes
        ).decode("utf-8")

        return jsonify({
            "status": "ok",
            "tile_id": tile_index,
            "ra": ra,
            "dec": dec,
            "tile_center": {
                "ra": tile_ra,
                "dec": tile_dec
            },
            "channel": channel,
            "image": (
                "data:image/png;base64,"
                + encoded_image
            ),
            "data_url": (
                "data:image/png;base64,"
                + encoded_image
            ),
            "source": get_png_url(
                tile_index,
                channel
            )
        })

    except KeyError as error:
        return jsonify({
            "status": "error",
            "message": f"Missing parameter: {error}"
        }), 400

    except (ValueError, TypeError) as error:
        return jsonify({
            "status": "error",
            "message": str(error)
        }), 400

    except requests.RequestException as error:
        return jsonify({
            "status": "archive_error",
            "message": str(error)
        }), 502

    except Exception as error:
        app.logger.exception("Sky tile error")

        return jsonify({
            "status": "error",
            "message": str(error)
        }), 500


# --------------------------------------------------
# CUTOUT COMPATIBILITY ROUTE
# --------------------------------------------------

@app.route("/api/cutout")
def cutout():
    return sky_tile()


# --------------------------------------------------
# OBSERVATIONS
# --------------------------------------------------

@app.route("/api/observations")
def observations():
    try:
        ra = float(request.args["ra"])
        dec = float(request.args["dec"])

        validate_coordinates(ra, dec)

        tile_index = get_tile_index(ra, dec)
        tile_ra, tile_dec = get_tile_center(tile_index)

        return jsonify({
            "status": "ok",
            "tile_id": tile_index,
            "ra": ra,
            "dec": dec,
            "tile_center": {
                "ra": tile_ra,
                "dec": tile_dec
            },
            "data_source": HIPS_BASE_URL,
            "spectral_channels": TOTAL_CHANNELS,
            "note": (
                "A tile lookup identifies an archive location. "
                "It does not establish a time-domain detection."
            )
        })

    except (KeyError, ValueError, TypeError) as error:
        return jsonify({
            "status": "error",
            "message": str(error)
        }), 400


# --------------------------------------------------
# CANDIDATE LOG
# --------------------------------------------------

@app.route("/api/candidates", methods=["GET", "POST", "DELETE"])
def candidates():
    if request.method == "GET":
        return jsonify({
            "status": "ok",
            "candidates": load_candidates()
        })

    if request.method == "DELETE":
        save_candidates([])

        return jsonify({
            "status": "ok",
            "message": "Candidate log cleared."
        })

    data = request.get_json(silent=True)

    if not isinstance(data, dict):
        return jsonify({
            "status": "error",
            "message": "Expected a JSON object."
        }), 400

    candidate_list = load_candidates()

    candidate = {
        **data,
        "record_type": "inspection_record",
        "scientifically_confirmed": False
    }

    candidate_list.append(candidate)
    save_candidates(candidate_list)

    return jsonify({
        "status": "ok",
        "message": "Inspection record saved.",
        "candidate": candidate
    }), 201


# --------------------------------------------------
# FRONTEND
# --------------------------------------------------

@app.route("/")
def index():
    return send_from_directory(BASE_DIR, "index.html")


@app.route("/app.js")
def javascript():
    return send_from_directory(BASE_DIR, "app.js")


@app.route("/styles.css")
def stylesheet():
    return send_from_directory(BASE_DIR, "styles.css")


@app.route("/data/<path:filename>")
def data_files(filename):
    return send_from_directory(
        BASE_DIR / "data",
        filename
    )


# --------------------------------------------------
# START SERVER
# --------------------------------------------------

if __name__ == "__main__":
    app.run(
        host="0.0.0.0",
        port=int(os.environ.get("PORT", 5000)),
        debug=False
    )